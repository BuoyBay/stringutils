''' Unicode version for StringUtils folding and White_Space classification.
Public Function StringUtilsUnicodeVersion() As String
    Return "17.0.0"
End Function

Private Class StringUtilsUnicodeData
' BEGIN GENERATED STRINGUTILS UNICODE
' Unicode 17.0.0 C/F mappings; Turkic T mappings are intentionally excluded.
' Generated by tools/generate_stringutils_unicode.py; resources/unicode-LICENSE.txt.
    Private Shared Property mIndex As Bytes = Bytes.FromBase64("").Value
    Private Shared Property mPayload As Bytes = Bytes.FromBase64("").Value
    Public Shared Function IsWhitespace(scalar As Integer) As Boolean
        Select Case scalar
            Case 9, 10, 11, 12, 13, 32, 133, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288
                Return True
        End Select
        Return False
    End Function
' END GENERATED STRINGUTILS UNICODE

    Private Shared Function Read32(data As Bytes, offset As Integer) As Integer
        Return data.Item(offset) + data.Item(offset + 1) * 256 + data.Item(offset + 2) * 65536 + data.Item(offset + 3) * 16777216
    End Function

    Private Shared Sub AppendBounded(output As Array Of Integer, scalar As Integer, limit As Integer)
        If Array.Count(output) >= limit Then Throw New InvalidArgumentException("Case folding exceeds maxScalars")
        Array.Append(output, scalar)
    End Sub

    Public Shared Sub FoldScalar(scalar As Integer, output As Array Of Integer, limit As Integer)
        Dim low As Integer = 0
        Dim high As Integer = mIndex.Count \ 9 - 1
        While low <= high
            Dim middle As Integer = (low + high) \ 2
            Dim record As Integer = middle * 9
            Dim key As Integer = StringUtilsUnicodeData.Read32(mIndex, record)
            If scalar = key Then
                Dim offset As Integer = StringUtilsUnicodeData.Read32(mIndex, record + 4)
                Dim length As Integer = mIndex.Item(record + 8)
                For i As Integer = 0 To length - 1
                    StringUtilsUnicodeData.AppendBounded(output, StringUtilsUnicodeData.Read32(mPayload, offset + i * 4), limit)
                Next
                Exit Sub
            End If
            If scalar < key Then
                high = middle - 1
            Else
                low = middle + 1
            End If
        End While
        StringUtilsUnicodeData.AppendBounded(output, scalar, limit)
    End Sub
End Class

Private Sub CheckUnicodeBudget(text As String, maxScalars As Integer)
    If maxScalars < 0 Then Throw New InvalidArgumentException("maxScalars must be nonnegative")
    If String.Len(text) > maxScalars Then Throw New InvalidArgumentException("Unicode text exceeds maxScalars")
End Sub

Private Function FoldScalars(text As String, maxScalars As Integer) As Array Of Integer
    CheckUnicodeBudget(text, maxScalars)
    Dim output() As Integer
    For Each ch As String In String.Chars(text)
        StringUtilsUnicodeData.FoldScalar(String.Asc(ch), output, maxScalars)
    Next
    Return output
End Function

''' Unicode default full case fold, without normalization or locale-specific tailoring.
Public Function CaseFold(text As String, maxScalars As Integer = 1000000) As String
    Dim output() As String
    For Each scalar As Integer In FoldScalars(text, maxScalars)
        Array.Append(output, String.Chr(scalar))
    Next
    Return String.Join(output, "")
End Function

''' Compare full case-folded scalar sequences; returns -1, 0 or 1.
Public Function CaselessCompare(leftText As String, rightText As String, maxScalars As Integer = 1000000) As Integer
    Dim leftScalars As Array Of Integer = FoldScalars(leftText, maxScalars)
    Dim rightScalars As Array Of Integer = FoldScalars(rightText, maxScalars)
    Dim length As Integer = Array.Count(leftScalars)
    If Array.Count(rightScalars) < length Then length = Array.Count(rightScalars)
    For i As Integer = 0 To length - 1
        If leftScalars(i) < rightScalars(i) Then Return -1
        If leftScalars(i) > rightScalars(i) Then Return 1
    Next
    If Array.Count(leftScalars) < Array.Count(rightScalars) Then Return -1
    If Array.Count(leftScalars) > Array.Count(rightScalars) Then Return 1
    Return 0
End Function

Public Function CaselessEquals(leftText As String, rightText As String, maxScalars As Integer = 1000000) As Boolean
    Return CaselessCompare(leftText, rightText, maxScalars) = 0
End Function

''' First caseless match at complete source-scalar boundaries; returns original zero-based index or -1.
Public Function CaselessIndexOf(text As String, needle As String, startIndex As Integer = 0, maxScalars As Integer = 1000000) As Integer
    CheckUnicodeBudget(text, maxScalars)
    CheckUnicodeBudget(needle, maxScalars)
    Dim length As Integer = String.Len(text)
    If startIndex < 0 Or startIndex > length Then Throw New InvalidArgumentException("startIndex is outside text")
    Dim pattern As Array Of Integer = FoldScalars(needle, maxScalars)
    Dim source() As Integer
    Dim boundaries() As Integer
    Array.Append(boundaries, 0)
    Dim original As Integer = 0
    For Each ch As String In String.Chars(text)
        Dim prior As Integer = Array.Count(source)
        StringUtilsUnicodeData.FoldScalar(String.Asc(ch), source, maxScalars)
        For i As Integer = prior + 1 To Array.Count(source) - 1
            Array.Append(boundaries, -1)
        Next
        original += 1
        Array.Append(boundaries, original)
    Next
    If Array.Count(pattern) = 0 Then Return startIndex
    ' KMP prefix table and scan keep search linear even for repeated-prefix input.
    Dim prefix(Array.Count(pattern)) As Integer
    Dim matched As Integer = 0
    For i As Integer = 1 To Array.Count(pattern) - 1
        While matched > 0 And pattern(i) <> pattern(matched)
            matched = prefix(matched - 1)
        End While
        If pattern(i) = pattern(matched) Then matched += 1
        prefix(i) = matched
    Next
    matched = 0
    For i As Integer = 0 To Array.Count(source) - 1
        While matched > 0 And source(i) <> pattern(matched)
            matched = prefix(matched - 1)
        End While
        If source(i) = pattern(matched) Then matched += 1
        If matched = Array.Count(pattern) Then
            Dim first As Integer = i + 1 - matched
            If boundaries(first) >= startIndex And boundaries(i + 1) >= 0 Then Return boundaries(first)
            matched = prefix(matched - 1)
        End If
    Next
    Return -1
End Function

Public Function CaselessContains(text As String, needle As String, maxScalars As Integer = 1000000) As Boolean
    Return CaselessIndexOf(text, needle, 0, maxScalars) >= 0
End Function

Private Function TrimUnicodeRange(text As String, trimLeft As Boolean, trimRight As Boolean, maxScalars As Integer) As String
    CheckUnicodeBudget(text, maxScalars)
    Dim chars As Array Of String = String.Chars(text)
    Dim first As Integer = 0
    Dim finish As Integer = Array.Count(chars)
    If trimLeft Then
        While first < finish
            If Not StringUtilsUnicodeData.IsWhitespace(String.Asc(chars(first))) Then Exit While
            first += 1
        End While
    End If
    If trimRight Then
        While finish > first
            If Not StringUtilsUnicodeData.IsWhitespace(String.Asc(chars(finish - 1))) Then Exit While
            finish -= 1
        End While
    End If
    Return String.Substring(text, first, finish - first)
End Function

''' Trim exactly Unicode White_Space, including NBSP, without changing interior text.
Public Function UnicodeTrim(text As String, maxScalars As Integer = 1000000) As String
    Return TrimUnicodeRange(text, True, True, maxScalars)
End Function

Public Function UnicodeLTrim(text As String, maxScalars As Integer = 1000000) As String
    Return TrimUnicodeRange(text, True, False, maxScalars)
End Function

Public Function UnicodeRTrim(text As String, maxScalars As Integer = 1000000) As String
    Return TrimUnicodeRange(text, False, True, maxScalars)
End Function
